rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Reports images: Public read, authenticated write, size limit 12MB, image MIME only
    match /reports/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
