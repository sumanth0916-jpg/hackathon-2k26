# ==========================================
# CampusConnect AI — Environment Configuration
# ==========================================

# 1. Google Gemini AI Key (Optional for live multimodal extraction; deterministic fallback engine is built-in)
VITE_GEMINI_API_KEY=

# 2. Firebase Public Web Configuration (Optional for cloud sync; standalone offline repository is active by default)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 3. Google Maps Platform API Key (Optional)
VITE_GOOGLE_MAPS_API_KEY=
